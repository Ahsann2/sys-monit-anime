{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "VivoGuard Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VIVOGUARD_BUILD_UI": "ON",
        "VIVOGUARD_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "VivoGuard Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VIVOGUARD_BUILD_UI": "ON",
        "VIVOGUARD_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "core-only",
      "displayName": "Core without Qt UI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VIVOGUARD_BUILD_UI": "OFF",
        "VIVOGUARD_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "core-only",
      "configurePreset": "core-only"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-only",
      "configurePreset": "core-only",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
